# Copy to .env.local and fill in real values. Do not commit .env.local.

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (not yet wired; reserve names) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend, not yet wired) ---
# RESEND_API_KEY=
# EMAIL_FROM="ProjectMarket <noreply@example.com>"

# --- Maps ---
# Google Maps — used by the /preview/play map pages.
# Get a key at: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API (and optionally: Places API for later).
# Without this key the preview map gracefully falls back to a placeholder.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a cloud-based Map ID for custom styling.
# Without this we use Google's "DEMO_MAP_ID" which is fine for development.
# NEXT_PUBLIC_GOOGLE_MAPS_ID=

# Mapbox (not yet wired)
# NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Analytics (PostHog or Plausible, not yet wired) ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# --- Error monitoring (Sentry, not yet wired) ---
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# --- Payments (Stripe, idea catalogue — not in foundation) ---
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
