# Copy to .env.local and fill in real values. Do not commit .env.local.

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Project settings → API
# These three are required for the signup/login flow to work.
# NEXT_PUBLIC_* keys are safe to expose to the browser (RLS protects data).
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY — never import it from a client component.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Where Supabase confirmation/magic-link emails redirect after the user clicks.
# Set to the live origin on each environment (preview branches use their own).
# NEXT_PUBLIC_SITE_URL=https://heia-jet.vercel.app

# --- Email (Resend, not yet wired) ---
# RESEND_API_KEY=
# EMAIL_FROM="ProjectMarket <noreply@example.com>"

# --- Maps ---
# Google Maps — used by the /preview/play map pages.
# Get a key at: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API (and optionally: Places API for later).
# Without this key the preview map gracefully falls back to a placeholder.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a cloud-based Map ID for custom styling.
# Without this we use Google's "DEMO_MAP_ID" which is fine for development.
# NEXT_PUBLIC_GOOGLE_MAPS_ID=

# Mapbox (not yet wired)
# NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Analytics (PostHog or Plausible, not yet wired) ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# --- Error monitoring (Sentry, not yet wired) ---
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# --- Payments (Stripe) ---
# See docs/STRIPE_SETUP.md for the full walkthrough.
# Server secret + webhook signing secret (server-only):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Platform commission in basis points (1000 = 10%) and the payout currency:
# PLATFORM_FEE_BPS=1000
# STRIPE_CURRENCY=ron
#
# Subscription plans — set the recurring Price IDs you create in Stripe.
# Only the ones you set will appear as plans.
# STRIPE_PRICE_PRO=price_...
# STRIPE_PLAN_PRO_NAME=Pro
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PLAN_PREMIUM_NAME=Premium
#
# Requires SUPABASE_SERVICE_ROLE_KEY (above) for the webhook to write results.
